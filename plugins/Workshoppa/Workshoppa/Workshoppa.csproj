<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Version>9.3.13.5</Version>
        <OutputPath>dist</OutputPath>
    </PropertyGroup>

    <Import Project="..\LLib\LLib.targets"/>
    <Import Project="..\LLib\RenameZip.targets"/>

    <ItemGroup>
        <ProjectReference Include="..\LLib\LLib.csproj" />
    </ItemGroup>
    <Target Name="IncludeVoyageAttribution" AfterTargets="DefaultDalamudPackagerRelease" Condition="'$(Configuration)' == 'Release'">
        <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\Add-VoyageAttribution.ps1&quot; -PackageDirectory &quot;$(MSBuildProjectDirectory)\dist\Workshoppa&quot;" />
    </Target>
</Project>
