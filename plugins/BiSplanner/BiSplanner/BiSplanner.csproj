<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Version>0.3.0.0</Version>
        <Description>Gearing, simplified.</Description>
        <PackageProjectUrl>https://github.com/Jacob5800/DalamudPlugins</PackageProjectUrl>
        <RepoUrl>https://github.com/Jacob5800/DalamudPlugins</RepoUrl>
        <Author>Lily; Jacob5800 (BiSplanner fork)</Author>
        <Name>BiSplanner</Name>
        <AssemblyName>BiSplanner</AssemblyName>
        <DalamudApiLevel>15</DalamudApiLevel>
        <TestingDalamudApiLevel>15</TestingDalamudApiLevel>
        <Punchline>Gearing, simplified.</Punchline>
        <Description>Highlights gear, coffers, and materia needed for all your gearsets
Import from from Etro, Xivgear, or Teamcraft for easy setup

Highlights items needed for gearsets on:
    - Need/Greed Loot Windows
    - NPC Shops and Exchanges
    - Marketboard
    - Player Inventories
    - Item Tooltips

When melding materia, highlights:
    - Items to meld
    - Materia to meld to item

Automatically syncs gearsets with player inventory</Description>
        <Tags>bis;loot;best in slot;need;greed;gearset;gear;coffer;materia;meld;etro;xivgear</Tags>
        <ImageUrls>
            https://raw.githubusercontent.com/Jacob5800/DalamudPlugins/main/plugins/BiSplanner/images/needgreed.png;
            https://raw.githubusercontent.com/Jacob5800/DalamudPlugins/main/plugins/BiSplanner/images/npcshopexchange.png;
            https://raw.githubusercontent.com/Jacob5800/DalamudPlugins/main/plugins/BiSplanner/images/materiamelding.png;
            https://raw.githubusercontent.com/Jacob5800/DalamudPlugins/main/plugins/BiSplanner/images/inventory.png;
            https://raw.githubusercontent.com/Jacob5800/DalamudPlugins/main/plugins/BiSplanner/images/itemtooltip.png
        </ImageUrls>
        <IconUrl>https://raw.githubusercontent.com/Jacob5800/DalamudPlugins/main/plugins/BiSplanner/images/icon.png</IconUrl>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
        <IsPackable>false</IsPackable>
        <Changelog>Initial BiSplanner release: per-set enable checkboxes and an optional server-bar shortcut, disabled by default.</Changelog>
        <NeutralLanguage>en</NeutralLanguage>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Autofac" Version="9.3.4" />
        <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Fastenshtein" Version="1.0.12" />
        <PackageReference Include="LinearAssignment" Version="1.2.0" />
        <PackageReference Include="Lumina" Version="7.1.0" />
        <PackageReference Include="Lumina.Excel" Version="7.4.1" />
        <PackageReference Include="LuminaSupplemental.Excel" Version="*" />
	    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
	    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" Version="22.2.0" />
        <PackageReference Include="Wacton.Unicolour" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Resources\Resource.ja.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resource.ja.resx</DependentUpon>
        </Compile>
        <Compile Update="Resources\Resource.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resource.resx</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\Resource.ja.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Resource.ja.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\Resource.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Resource.Designer.cs</LastGenOutput>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\KamiToolKit\KamiToolKit.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
    </ItemGroup>
</Project>
